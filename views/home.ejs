  <!-- ══════════════════════════════════════════════════
     SECTION 2 — ABOUT
══════════════════════════════════════════════════ -->
  <section class="about-section" id="about">
    <div class="container">
      <div class="about-content">
        <div class="about-text">
          <span class="section-label lang-en">About Us</span>
          <span class="section-label lang-ta">எங்களைப் பற்றி</span>
          <h2 class="lang-en">Welcome to Nevin Scientific Research</h2>
          <h2 class="lang-ta">நெவின் அறிவியல் ஆராய்ச்சி மையத்திற்கு வரவேற்கிறோம்</h2>

          <div class="lang-en" style="margin-top:1.5rem">
            <p>Nevin Scientific Research is a premier academic and scientific platform dedicated to promoting quality
              research, innovation, education, and global knowledge-sharing.</p>
            <p>We strive to create an ecosystem where scholars, scientists, educators, and students collaborate to solve
              real-world challenges through research and discovery.</p>
          </div>

          <div class="lang-ta" style="margin-top:1.5rem">
            <p>தரமான ஆராய்ச்சி, புதுமை, கல்வி மற்றும் உலகளாவிய அறிவுப் பகிர்வை முன்னேற்றும் முன்னணி கல்வி மற்றும்
              அறிவியல் தளம்.</p>
            <p>ஆராய்ச்சி மற்றும் கண்டுபிடிப்புகள் மூலம் நிஜ உலக சவால்களுக்கு தீர்வு காண அறிஞர்கள், விஞ்ஞானிகள்,
              ஆசிரியர்கள் மற்றும் மாணவர்கள் இணைந்து செயல்படும் சூழலை உருவாக்க முயல்கிறோம்.</p>
          </div>

          <p class="lang-en" style="margin-top:2rem;line-height:1.7;color:var(--ink-muted);font-size:0.95rem;">
            Our organization supports conferences, publications, workshops, seminars, and interdisciplinary projects that contribute to academic growth and societal development.
          </p>
          <p class="lang-ta" style="margin-top:2rem;line-height:1.7;color:var(--ink-muted);font-size:0.95rem;">
            எங்கள் நிறுவனம் கல்வி வளர்ச்சி மற்றும் சமூக மேம்பாட்டிற்கு பங்களிக்கும் மாநாடுகள், வெளியீடுகள், பயிலரங்குகள், கருத்தரங்குகள் மற்றும் பல்துறை சார்ந்த திட்டங்களுக்கு ஆதரவளிக்கிறது.
          </p>
        </div>

        <div class="about-emblem">
          <div class="about-emblem-inner"
            style="width:200px;height:200px;border-radius:50%;display:flex;align-items:center;justify-content:center;overflow:hidden;padding:0;">
            <img src="/logo.png" alt="Nevin Scientific Research Logo"
              style="width:100%;height:100%;object-fit:cover;border-radius:50%;">
          </div>
          <blockquote
            style="margin-top:2rem;font-style:italic;color:var(--ink-muted);font-size:0.95rem;border-left:3px solid var(--gold);padding-left:1rem;text-align:left">
            <div class="lang-en">
              "Innovation begins with curiosity and succeeds through research."<br>
              <cite style="font-size:0.8rem;color:var(--gold)">— Nevin Scientific Research</cite>
            </div>
            <div class="lang-ta">
              "ஆர்வத்தில் தொடங்கும் புதுமை, ஆராய்ச்சியில் வெற்றி பெறுகிறது."<br>
              <cite style="font-size:0.8rem;color:var(--gold)">— நெவின் அறிவியல் ஆராய்ச்சி</cite>
            </div>
          </blockquote>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════
     SECTION 3 — VISION & MISSION (COMBINED)
══════════════════════════════════════════════════ -->
  <section class="section bg-white" id="vision-mission">
    <div class="container">
      <div class="section-header animate">
        <span class="section-label lang-en">Our Direction</span>
        <span class="section-label lang-ta">எங்கள் திசை</span>
        <h2 class="lang-en">Vision & Mission</h2>
        <h2 class="lang-ta">நோக்கமும் பணியும்</h2>
        <div class="section-divider"><span>✦</span></div>
      </div>

      <!-- Vision Card (full-width banner style) -->
      <div class="vm-vision-card animate" style="animation-delay:0.1s">
        <div class="vm-vision-icon">
          <i data-lucide="telescope" style="width:32px;height:32px;color:var(--gold)"></i>
        </div>
        <div>
          <h3 class="lang-en" style="color:var(--gold-light);margin-bottom:0.75rem;font-size:1.4rem">Our Vision</h3>
          <h3 class="lang-ta" style="color:var(--gold-light);margin-bottom:0.75rem;font-size:1.4rem">எங்கள் நோக்கம்</h3>
          <p class="lang-en" style="color:rgba(250,246,238,0.85);margin:0;font-size:1.05rem;line-height:1.8">To become a
            globally recognized center for scientific research and academic excellence by fostering innovation, ethical
            research practices, and transformative knowledge for society.</p>
          <p class="lang-ta" style="color:rgba(250,246,238,0.85);margin:0;font-size:1.05rem;line-height:1.8">புதுமை,
            நெறிமுறை சார்ந்த ஆராய்ச்சி மற்றும் சமூக மாற்றத்திற்கான அறிவை வளர்த்து, உலகளவில் அங்கீகரிக்கப்பட்ட அறிவியல்
            மற்றும் கல்வி மையமாக உருவாகுவது.</p>
        </div>
      </div>

      <!-- Mission Grid -->
      <div style="margin-top:3rem">
        <h3 class="lang-en" style="text-align:center;color:var(--kolam-red);margin-bottom:0.5rem">Our Mission</h3>
        <h3 class="lang-ta" style="text-align:center;color:var(--kolam-red);margin-bottom:0.5rem">எங்கள் பணி</h3>
        <div class="section-divider" style="margin-bottom:2.5rem"><span>✦</span></div>

        <div class="grid-3" style="gap:1.5rem">
          <% const missionEn=[ 'Promote high-quality interdisciplinary research'
            , 'Encourage innovation and scientific thinking'
            , 'Support researchers with publication and academic guidance'
            , 'Organize conferences, seminars, and workshops' , 'Build global academic and industrial collaborations'
            , 'Inspire young scholars toward meaningful discoveries'
            , 'Integrate traditional knowledge with modern science' ]; %>
            <% const missionTa=[ 'உயர்தர பல்துறை ஆராய்ச்சிகளை ஊக்குவித்தல்'
              , 'புதுமை மற்றும் அறிவியல் சிந்தனையை வளர்த்தல்'
              , 'ஆராய்ச்சியாளர்களுக்கு வெளியீடு மற்றும் கல்வி வழிகாட்டுதல் வழங்குதல்'
              , 'மாநாடுகள், கருத்தரங்குகள் மற்றும் பயிற்சி முகாம்களை நடத்துதல்'
              , 'உலகளாவிய கல்வி மற்றும் தொழில் ஒத்துழைப்புகளை உருவாக்குதல்'
              , 'இளம் ஆராய்ச்சியாளர்களை பயனுள்ள கண்டுபிடிப்புகளுக்கு ஊக்குவித்தல்'
              , 'பாரம்பரிய அறிவையும் நவீன அறிவியலையும் ஒருங்கிணைத்தல்' ]; %>
              <% const missionIcons=['microscope','lightbulb','book-open','users','globe','star','layers']; %>
                <% missionEn.forEach((item, i)=> { %>
                  <div class="mission-card animate" style="animation-delay:<%= 0.08 * i %>s">
                    <div class="mission-card-num">
                      <%= String(i+1).padStart(2,'0') %>
                    </div>
                    <div class="mission-card-icon">
                      <i data-lucide="<%= missionIcons[i] %>" style="width:22px;height:22px;color:var(--gold)"></i>
                    </div>
                    <p class="lang-en" style="margin:0;color:var(--ink-soft);font-size:0.95rem;line-height:1.6">
                      <%= item %>
                    </p>
                    <p class="lang-ta" style="margin:0;color:var(--ink-soft);font-size:0.95rem;line-height:1.6">
                      <%= missionTa[i] %>
                    </p>
                  </div>
                  <% }); %>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════
     SECTION 4 — WHY CHOOSE US
══════════════════════════════════════════════════ -->
  <section class="section bg-parchment" id="why-us">
    <div class="container">
      <div class="section-header animate">
        <span class="section-label lang-en">Why Choose Us</span>
        <span class="section-label lang-ta">ஏன் தேர்வு செய்ய வேண்டும்</span>
        <h2 class="lang-en">Why Nevin Scientific Research?</h2>
        <h2 class="lang-ta">ஏன் நெவின் அறிவியல் ஆராய்ச்சி?</h2>
        <div class="section-divider"><span>✦</span></div>
      </div>

      <% const whyEn=['Research Excellence','Global Collaboration','Innovation & Development','Academic Integrity','Professional Growth']; %>
      <% const whyTa=['ஆராய்ச்சி சிறப்பு','உலகளாவிய ஒத்துழைப்பு','புதுமை மற்றும் வளர்ச்சி','கல்வி நேர்மை','தொழில்முறை முன்னேற்றம்']; %>
          <% const whyIcons=['award','globe-2','zap','shield-check','trending-up']; %>
            <% const
              whyDesc_en=[ 'Peer-reviewed publications meeting the highest international standards of academic quality.'
              , 'Partnerships with institutions and researchers from across the globe for inclusive scholarship.'
              , 'A culture of forward-thinking innovation driving real-world impact and scientific breakthroughs.'
              , 'Rigorous ethical standards ensuring transparency, honesty, and scholarly credibility.'
              , 'Mentorship, workshops, and growth pathways for emerging scholars and early-career researchers.' ]; %>
              <% const whyDesc_ta=[ 'சர்வதேச தர நிலைகளை பூர்த்தி செய்யும் மதிப்பாய்வு செய்யப்பட்ட வெளியீடுகள்.'
                , 'உலகெங்கிலும் உள்ள நிறுவனங்கள் மற்றும் ஆராய்ச்சியாளர்களுடன் பங்கு கொள்ளல்.'
                , 'நிஜ உலக தாக்கத்தை ஏற்படுத்தும் புதுமையான சிந்தனைகளை வளர்க்கும் கலாச்சாரம்.'
                , 'வெளிப்படைத்தன்மை, நேர்மை மற்றும் கல்வி நம்பகத்தன்மையை உறுதி செய்யும் நெறிமுறைகள்.'
                , 'வளரும் ஆராய்ச்சியாளர்களுக்கான வழிகாட்டுதல், பயிற்சிகள் மற்றும் வளர்ச்சி பாதைகள்.' ]; %>

                <div class="grid-3" style="gap:2rem">
                  <% whyEn.forEach((title, i)=> { %>
                    <div class="why-card card animate" style="animation-delay:<%= 0.1 * i %>s">
                      <div class="card-body" style="text-align:center;padding:2.5rem 2rem">
                        <div class="why-card-icon">
                          <i data-lucide="<%= whyIcons[i] %>" style="width:28px;height:28px;color:var(--kolam-red)"></i>
                        </div>
                        <h3 class="lang-en" style="font-size:1.15rem;margin:1rem 0 0.6rem;color:var(--kolam-red)">
                          <%= title %>
                        </h3>
                        <h3 class="lang-ta" style="font-size:1.15rem;margin:1rem 0 0.6rem;color:var(--kolam-red)">
                          <%= whyTa[i] %>
                        </h3>
                        <p class="lang-en" style="font-size:0.9rem;color:var(--ink-muted);margin:0;line-height:1.6">
                          <%= whyDesc_en[i] %>
                        </p>
                        <p class="lang-ta" style="font-size:0.9rem;color:var(--ink-muted);margin:0;line-height:1.6">
                          <%= whyDesc_ta[i] %>
                        </p>
                      </div>
                    </div>
                    <% }); %>
                </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════
     SECTION 5 — TAMIL WISDOM QUOTE
══════════════════════════════════════════════════ -->
  <section class="kolam-quote-section">
    <div class="container">
      <div class="kolam-quote-inner animate">
        <div class="kolam-quote-ornament">❋</div>
        <blockquote class="kolam-quote-text lang-ta">
          தொட்டனைத் தூறும் மணற்கேணி மாந்தர்க்குக்<br>கற்றனைத் தூறும் அறிவு.
        </blockquote>
        <p class="kolam-quote-meaning lang-en">Knowledge continuously grows for those who keep learning.</p>
        <p class="kolam-quote-meaning lang-ta" style="font-style:italic;font-size:0.95rem;opacity:0.8">கற்கக் கற்க அறிவு
          பெருகும்.</p>
        <div class="kolam-quote-ornament">❋</div>
        <cite class="kolam-quote-source">— திருக்குறள் / Thirukkural</cite>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════
     SECTION 6 — NEWS & ANNOUNCEMENTS
══════════════════════════════════════════════════ -->
  <section class="section bg-white" id="news">
    <div class="container">
      <div class="section-header animate">
        <span class="section-label lang-en">Latest Updates</span>
        <span class="section-label lang-ta">சமீபத்திய புதுப்பிப்புகள்</span>
        <h2 class="lang-en">News & Announcements</h2>
        <h2 class="lang-ta">செய்திகள் & அறிவிப்புகள்</h2>
        <div class="section-divider"><span>✦</span></div>
      </div>

      <% if (news && news.length> 0) { %>
        <div class="news-grid">
          <% news.forEach((item, idx)=> { %>
            <article class="news-card animate" style="animation-delay:<%= idx * 0.1 %>s">
              <span class="news-badge">
                <%= item.category || 'General' %>
              </span>
              <h3><a href="/news/<%= item.id %>" style="color:var(--ink);text-decoration:none">
                  <%= item.title %>
                </a></h3>
              <p
                style="font-size:0.88rem;color:var(--ink-muted);margin:0.5rem 0;overflow:hidden;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical">
                <%= item.body %>
              </p>
              <div
                style="display:flex;justify-content:space-between;align-items:center;margin-top:0.8rem;flex-wrap:wrap;gap:0.5rem;width:100%">
                <div class="news-date" style="margin:0">
                  <%= new Date(item.created_at).toLocaleDateString('en-IN', { year:'numeric', month:'long',
                    day:'numeric' }) %>
                </div>
                <% if (item.link) { %>
                  <a href="<%= item.link %>" target="_blank" class="news-card-link-btn"
                    style="font-size:0.8rem;color:var(--kolam-red);font-weight:600;text-decoration:none;display:inline-flex;align-items:center;gap:0.25rem;transition:var(--transition);border-bottom:1px dashed transparent">
                    <i data-lucide="external-link" style="width:14px;height:14px;"></i>
                    <span class="lang-en">External Link</span>
                    <span class="lang-ta">வெளிப்புற இணைப்பு</span>
                  </a>
                  <% } %>
              </div>
            </article>
            <% }); %>
        </div>
        <% } else { %>
          <p style="text-align:center;color:var(--ink-muted);font-style:italic">No announcements yet. Check back soon.
          </p>
          <% } %>

            <div style="text-align:center;margin-top:2.5rem">
              <a href="/news" class="btn btn-red">
                <span class="lang-en">View All News</span>
                <span class="lang-ta">அனைத்து செய்திகளையும் காண</span>
              </a>
            </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════
     SECTION 7 — ACTIVITIES
══════════════════════════════════════════════════ -->
  <section class="section bg-parchment" id="activities">
    <div class="container">
      <div class="section-header animate">
        <span class="section-label lang-en">What We Do</span>
        <span class="section-label lang-ta">நாங்கள் செய்வது</span>
        <h2 class="lang-en">Our Activities</h2>
