        , 'Scientific Journals' , 'Academic Collaborations' , 'Research Guidance' , 'Innovation & Technology Forums'
        , 'Student Development Programs' ]; %>
        <% const activitiesTa=[ 'சர்வதேச மாநாடுகள்' , 'ஆராய்ச்சி வெளியீடுகள்'
