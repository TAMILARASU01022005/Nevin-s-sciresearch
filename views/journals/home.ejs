<%- include('partials-header') %>

<!-- ABOUT JOURNAL -->
<section class="about-section">
  <div class="container">
    <div class="about-content">
      <div class="about-text">
        <span class="section-label">About the Journal</span>
        <h2>A Legacy of<br>Literary Excellence</h2>
        <p>The Tamil Literary Journal is a premier peer-reviewed publication committed to advancing academic discourse on Tamil language and literature, Sangam-era poetry, medieval Tamil texts, contemporary Tamil writing, and the global Tamil diaspora experience.</p>
        <p>We publish original research, critical essays, book reviews, and translations that contribute meaningfully to the field of Tamil studies.</p>
        <div style="margin-top:1.5rem;display:flex;gap:2rem;flex-wrap:wrap">
          <div><strong style="color:var(--kolam-red);font-family:var(--font-display);font-size:1.5rem">Quarterly</strong><br><small style="color:var(--ink-muted)">Publication Frequency</small></div>
          <div><strong style="color:var(--kolam-red);font-family:var(--font-display);font-size:1.5rem">Double-Blind</strong><br><small style="color:var(--ink-muted)">Peer Review</small></div>
          <div><strong style="color:var(--kolam-red);font-family:var(--font-display);font-size:1.5rem">Open Access</strong><br><small style="color:var(--ink-muted)">Policy</small></div>
        </div>
        <a href="/submit" class="btn btn-primary" style="margin-top:2rem">Submit Your Journal <i data-lucide="arrow-right" class="icon-inline" style="margin-left:0.35rem;margin-right:0;"></i></a>
      </div>
      <div class="about-emblem" style="text-align:center">
        <div style="display:inline-block;width:200px;height:200px;border-radius:50%;background:linear-gradient(135deg,var(--kolam-red),var(--kolam-dark));display:flex;align-items:center;justify-content:center;box-shadow:0 0 0 10px var(--parchment),0 0 0 12px var(--gold),0 0 40px var(--shadow);animation:float 4s ease-in-out infinite;overflow:hidden;padding:0;">
          <img src="/logo.png" alt="Arivan Logo" style="width:100%;height:100%;object-fit:cover;border-radius:50%;">
        </div>
      </div>
    </div>
  </div>
</section>

<!-- RECENT ARTICLES -->
<section class="section bg-white">
  <div class="container">
    <div class="section-header">
      <span class="section-label">Latest Research</span>
      <h2>Recent Articles</h2>
      <div class="section-divider"><span>✦</span></div>
    </div>

    <% if (journals && journals.length > 0) { %>
    <div class="grid-2">
      <% journals.forEach((j, i) => { %>
      <article class="card animate">
        <div class="card-body">
          <div class="card-meta">
            <% if (j.volume) { %>Vol. <%= j.volume %><% } %>
            <% if (j.issue) { %> • Issue <%= j.issue %><% } %>
            <% if (j.year) { %> • <%= j.year %><% } %>
            <% if (j.category) { %> &nbsp;<span class="tag"><%= j.category %></span><% } %>
          </div>
          <h3 class="card-title"><%= j.title %></h3>
          <% if (j.author) { %><div class="card-author">by <%= j.author %></div><% } %>
          <% if (j.abstract) { %>
          <p class="card-desc"><%= j.abstract.substring(0, 150) %><%= j.abstract.length > 150 ? '…' : '' %></p>
          <% } %>
          <a href="/download/journal/<%= j.id %>" class="btn btn-primary btn-sm">⬇ Download PDF</a>
        </div>
      </article>
      <% }) %>
    </div>
    <% } else { %>
    <p style="text-align:center;color:var(--ink-muted);font-style:italic;padding:2rem">No articles published yet.</p>
    <% } %>

    <div style="text-align:center;margin-top:2.5rem">
      <a href="/journals/articles" class="btn btn-red">View All Articles</a>
    </div>
  </div>
</section>

<!-- GUIDELINES -->
<section class="section bg-parchment">
  <div class="container">
    <div class="section-header">
      <span class="section-label">Policies</span>
      <h2>Guidelines & Policies</h2>
      <div class="section-divider"><span><i data-lucide="clipboard-list" style="width:20px;height:20px;stroke-width:1.5;"></i></span></div>
    </div>
    <div class="grid-3">
      <div class="form-box animate">
        <h3 style="font-size:1.1rem;margin-bottom:1rem;display:flex;align-items:center;gap:0.5rem"><i data-lucide="file-signature" style="width:18px;height:18px;color:var(--kolam-red);"></i> Submission</h3>
        <ul style="color:var(--ink-muted);font-size:0.9rem;line-height:2;padding-left:1.2rem">
          <li>Original unpublished work only</li>
          <li>4,000–10,000 words for articles</li>
          <li>200–300 word abstract required</li>
          <li>APA or MLA citation style</li>
          <li>PDF format submissions</li>
        </ul>
      </div>
      <div class="form-box animate">
        <h3 style="font-size:1.1rem;margin-bottom:1rem;display:flex;align-items:center;gap:0.5rem"><i data-lucide="search" style="width:18px;height:18px;color:var(--kolam-red);"></i> Review Process</h3>
        <ul style="color:var(--ink-muted);font-size:0.9rem;line-height:2;padding-left:1.2rem">
          <li>Double-blind peer review</li>
          <li>2–3 independent reviewers</li>
          <li>Decision within 8–12 weeks</li>
          <li>Constructive reviewer feedback</li>
          <li>Right of appeal available</li>
        </ul>
      </div>
      <div class="form-box animate">
        <h3 style="font-size:1.1rem;margin-bottom:1rem;display:flex;align-items:center;gap:0.5rem"><i data-lucide="book-open" style="width:18px;height:18px;color:var(--kolam-red);"></i> Publication</h3>
        <ul style="color:var(--ink-muted);font-size:0.9rem;line-height:2;padding-left:1.2rem">
          <li>Open access, no APC</li>
          <li>CC BY 4.0 license</li>
          <li>DOI assigned to all articles</li>
          <li>Indexed in major databases</li>
          <li>Both English & Tamil accepted</li>
        </ul>
      </div>
    </div>
    <div style="text-align:center;margin-top:2rem">
      <a href="/submit" class="btn btn-red" style="font-size:1.1rem;padding:1rem 3rem">Submit Your Work <i data-lucide="arrow-right" class="icon-inline" style="margin-left:0.35rem;margin-right:0;"></i></a>
    </div>
  </div>
</section>

<!-- CONTACT -->
<section class="section bg-white" id="contact">
  <div class="container" style="max-width:700px;text-align:center">
    <div class="section-header">
      <span class="section-label">
        <span class="lang-en">Reach Us</span>
        <span class="lang-ta">எங்களைத் தொடர்பு கொள்ள</span>
      </span>
      <h2>
        <span class="lang-en">Contact the Journal</span>
        <span class="lang-ta">ஆய்விதழ் தொடர்பு</span>
      </h2>
      <div class="section-divider"><span>✦</span></div>
    </div>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:1.5rem">
      <div class="form-box">
        <div style="margin-bottom:0.5rem;color:var(--kolam-red)"><i data-lucide="mail" style="width:32px;height:32px;stroke-width:1.5;"></i></div>
        <strong><span class="lang-en">Email</span><span class="lang-ta">மின்னஞ்சல்</span></strong><br>
        <a href="mailto:arivanjournal@gmail.com" style="font-size:0.9rem;font-weight:bold;color:var(--kolam-red)">arivanjournal@gmail.com</a>
      </div>
      <div class="form-box">
        <div style="margin-bottom:0.5rem;color:var(--kolam-red)"><i data-lucide="building" style="width:32px;height:32px;stroke-width:1.5;"></i></div>
        <strong><span class="lang-en">Publisher Office</span><span class="lang-ta">பதிப்பக அலுவலகம்</span></strong><br>
        <span style="font-size:0.85rem;color:var(--ink-muted)">Nevin Scientific Research Services</span>
      </div>
      <div class="form-box">
        <div style="margin-bottom:0.5rem;color:var(--kolam-red)"><i data-lucide="globe" style="width:32px;height:32px;stroke-width:1.5;"></i></div>
        <strong><span class="lang-en">Full Contact</span><span class="lang-ta">முழு விவரங்கள்</span></strong><br>
        <a href="/journals/contact" style="font-size:0.9rem">
          <span class="lang-en">Visit Contact Page</span>
          <span class="lang-ta">தொடர்பு பக்கம் செல்ல</span>
        </a>
      </div>
    </div>
  </div>
</section>

<%- include('partials-footer') %>
