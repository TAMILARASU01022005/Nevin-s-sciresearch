<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Login | Arivan</title>
  <link rel="stylesheet" href="/css/admin.css">
  <script src="/js/lucide.min.js"></script>
</head>
<body>
<div class="login-page">
  <div class="login-card">
    <div class="login-brand">
      <span class="emblem" style="display:inline-block;width:60px;height:60px;border-radius:50%;overflow:hidden;margin-bottom:0.5rem;"><img src="/logo.png" alt="Logo" style="width:100%;height:100%;object-fit:cover;border-radius:50%;"></span>
      <h1>Admin Portal</h1>
      <p>Arivan — Restricted Access</p>
    </div>

    <% if (error && error.length) { %>
    <div class="flash flash-error"><%= error[0] %></div>
    <% } %>

    <form action="/tamil-literature/admin/login" method="POST" novalidate>
      <div class="form-group">
        <label for="username">Username</label>
        <input type="text" id="username" name="username" required autocomplete="username" placeholder="Admin username">
      </div>
      <div class="form-group">
        <label for="password">Password</label>
        <input type="password" id="password" name="password" required autocomplete="current-password" placeholder="••••••••">
      </div>
      <button type="submit" class="btn btn-primary" style="width:100%;padding:0.9rem;font-size:1rem;justify-content:center;margin-top:0.5rem;display:flex;align-items:center;gap:0.35rem;">Login <i data-lucide="arrow-right" class="icon-inline" style="margin-left:0.25rem;margin-right:0;width:16px;height:16px;"></i></button>
    </form>

    <p style="text-align:center;margin-top:1.5rem;font-size:0.82rem;color:#999"><a href="/" style="color:#6B4F4F;display:inline-flex;align-items:center;gap:0.25rem;"><i data-lucide="arrow-left" class="icon-inline" style="width:14px;height:14px;margin-right:0.25rem;margin-left:0;"></i> Return to Public Portal</a></p>
  </div>
</div>
<script>
if (typeof lucide !== 'undefined') {
  lucide.createIcons();
}
</script>
</body>
</html>
